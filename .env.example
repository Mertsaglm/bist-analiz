# Bu dosyayı `.env` olarak kopyalayıp doldur. `.env` git'e GİRMEZ (.gitignore).
# ⚠ Değerleri BURAYA yazma — bu dosya repoda izleniyor. Yalnız `.env` içine yaz.

# --- Telegram bildirimi (Faz 8) -------------------------------------------
# BotFather'ın yeni bot açınca verdiği token. Biçim: 1234567890:AAE...
TELEGRAM_BOT_TOKEN=
# Mesajların gideceği sohbetin kimliği. Bulmak için: bota Telegram'dan
# herhangi bir mesaj yaz, sonra `bist bildir --chat-id` koş.
TELEGRAM_CHAT_ID=

# --- Otonom analist zinciri (config.llm.zincir) ---------------------------
# Gemini: https://aistudio.google.com/apikey  (ÜCRETSİZ katman var)
# Zincirin ilk dört halkası bunu kullanır. Yoksa hepsi elenir ve sistem
# doğrudan ücretli OpenAI halkalarına düşer — sessizce (bkz. analist.zincir).
GEMINI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys  (ücretsiz katman YOK)
# Yalnız tüm Gemini halkaları düştüğünde devreye girer (~$0.012/tur).
OPENAI_API_KEY=

# --- Makro (opsiyonel) ----------------------------------------------------
# TCMB EVDS API anahtarı — https://evds2.tcmb.gov.tr → Profilim > API Key Kopyala
# Yoksa makro katmanı null döner ve rapor ilgili satırları GİZLER (uydurma yapılmaz).
EVDS_API_KEY=
