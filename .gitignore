# Ortam
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# Sırlar
.env

# Kişisel — projeler arası ortak profil, repoya girmez (gold_tracking_system konvansiyonu)
ai/PROFILE.md

# Veri — SQLite git'e ham girmez (ikili, diff'lenmez)
data/*.db
data/*.db-wal
data/*.db-shm
data/backup/

# Deterministik SQL dump (src/dbdump.py) — şimdilik git'e GİRMİYOR.
# 15 MB türev veri; `bist veri backfill` ile ~3 dakikada yeniden üretiliyor.
# Faz 8'de (GitHub Actions) bu satır kaldırılacak: orada arşivin repoda olması
# gerekir çünkü Actions kendi veritabanını her koşuda sıfırdan kurar.
data/*.sql

# LLM çalıştırma çıktıları — girdi paketi (llm/in) izlenir, çıktı izlenmez
llm/out/

# Üretilen raporlar (arşivlenmek istenenler elle eklenir)
reports/*.md
!reports/.gitkeep

# Loglar
logs/*.log
logs/*.log.*
